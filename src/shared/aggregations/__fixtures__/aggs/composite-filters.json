      "aggs": {
        "segments": {
          "filters": { "filters": { "cheap": { "range": { "price": { "lt": 500000 } } }, "not_active": { "bool": { "must_not": [{ "term": { "status": "active" } }] } } } },
          "aggs": { "sellers": { "cardinality": { "field": "seller_id" } } }
        }
      }
    }
  }
