{
  "size": 0,
  "query": { "bool": { "filter": [{ "terms": { "status": ["active", "pending"] } }, { "range": { "price": { "gte": 100, "lte": 900000 } } }, { "exists": { "field": "city.name" } }] } },
  "aggs": {
    "by_city_and_type": {
